{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.drimini.invalid/release-evidence/packet-v1.schema.json",
  "title": "Release Evidence packet v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "tool",
    "repository",
    "boundary",
    "scan",
    "findings",
    "diagnostics",
    "assessment",
    "decision",
    "integrity"
  ],
  "properties": {
    "schema_version": { "const": "1" },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "rule_set_version"],
      "properties": {
        "name": { "const": "release-evidence" },
        "version": { "type": "string", "minLength": 1 },
        "rule_set_version": { "type": "string", "minLength": 1 }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision_state", "working_tree_state", "working_tree_note"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
        "revision_state": { "$ref": "#/$defs/state" },
        "working_tree_state": { "$ref": "#/$defs/state" },
        "working_tree_note": { "type": "string", "minLength": 1 }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root", "exclusions", "limits"],
      "properties": {
        "root": { "const": "." },
        "exclusions": { "type": "array", "items": { "type": "string" } },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_entries", "max_depth", "max_file_bytes", "max_total_read_bytes"],
          "properties": {
            "max_entries": { "type": "integer", "minimum": 1 },
            "max_depth": { "type": "integer", "minimum": 1 },
            "max_file_bytes": { "type": "integer", "minimum": 1 },
            "max_total_read_bytes": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "complete", "entries_visited", "files_considered"],
      "properties": {
        "generated_at": { "type": "string", "format": "date-time" },
        "complete": { "type": "boolean" },
        "entries_visited": { "type": "integer", "minimum": 0 },
        "files_considered": { "type": "integer", "minimum": 0 }
      }
    },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not_started", "in_progress", "complete"] },
        "context": { "type": "string", "maxLength": 4000 },
        "items": {
          "type": "array",
          "items": { "$ref": "#/$defs/assessment_item" }
        },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not_made", "approved", "blocked", "needs_work"] },
        "rationale": { "type": "string", "maxLength": 4000 },
        "owner": { "type": "string", "maxLength": 200 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "scope", "digest", "note"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "scope": { "const": "normalized-evidence-v1" },
        "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "state": {
      "enum": ["observed", "not_observed", "unknown", "not_applicable"]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line": { "type": "integer", "minimum": 1 }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule_version",
        "category",
        "title",
        "state",
        "confidence",
        "explanation",
        "limitations",
        "search_boundary",
        "citations"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$" },
        "rule_version": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "state": { "$ref": "#/$defs/state" },
        "confidence": { "enum": ["high", "medium", "low"] },
        "explanation": { "type": "string", "minLength": 1 },
        "limitations": { "type": "string", "minLength": 1 },
        "search_boundary": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "citations": {
          "type": "array",
          "items": { "$ref": "#/$defs/citation" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error"] },
        "path": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 }
      }
    },
    "assessment_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["finding_id", "disposition"],
      "properties": {
        "finding_id": { "type": "string", "minLength": 1 },
        "disposition": {
          "enum": ["open", "assigned", "accepted", "not_applicable", "resolved"]
        },
        "rationale": { "type": "string", "maxLength": 4000 },
        "owner": { "type": "string", "maxLength": 200 },
        "target_date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    }
  }
}
